# Copia este archivo a .env.local y rellena con los valores de tu proyecto
# en https://supabase.com/dashboard/project/_/settings/api
#
# Mientras estas dos primeras no estén definidas, isSupabaseConfigured()
# devuelve false y toda la app sigue funcionando con datos de muestra y
# favoritos/sesión en localStorage (ver app/providers.tsx).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para Route Handlers/Server Actions de /admin. Nunca prefijar con
# NEXT_PUBLIC_: expondría la clave al navegador y saltaría RLS para todos.
SUPABASE_SERVICE_ROLE_KEY=

# Usada por app/sitemap.ts, app/robots.ts y el JSON-LD de cada ficha.
NEXT_PUBLIC_SITE_URL=https://autora.example
